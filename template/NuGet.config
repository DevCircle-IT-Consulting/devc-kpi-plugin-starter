<?xml version="1.0" encoding="utf-8"?>
<!-- The SDK is public on nuget.org, so a plugin restores with NO private feed and no auth.
     `clear` drops any inherited machine/user feeds so a clean CI runner behaves identically. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
