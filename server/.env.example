# Copy to `.env` and fill in. Keep the real .env out of git (it holds the DB password).

# --- Engine images (licence-gated) ---------------------------------------------------
# DevCircle gives you the registry host, a pull credential (`docker login <host>`), and the
# tag to run. `${KPI_IMAGE}/api:<tag>` and `${KPI_IMAGE}/client:<tag>` are pulled.
KPI_IMAGE=kpi.devcircle.at:5000
KPI_IMAGE_TAG=REPLACE_WITH_THE_TAG_DEVCIRCLE_GIVES_YOU

# --- Container user -------------------------------------------------------------------
# The app containers run as this uid:gid so they can write the bind-mounted api/home, client/home and
# read your config. Linux: set to `id -u` / `id -g`. Docker Desktop (Win/Mac): leave 1000.
KPI_UID=1000
KPI_GID=1000

# --- In-stack PostgreSQL --------------------------------------------------------------
# The API's connection string is built from these (see docker-compose.yml).
POSTGRES_USER=kpi
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=kpi
