# Copy to `.env` and fill in. Keep the real .env out of git (it holds the proxy key).

# The proxy image (same registry + tag as your engine; DevCircle provides the credential).
KPI_IMAGE=kpi.devcircle.at:5000
KPI_IMAGE_TAG=REPLACE_WITH_THE_SAME_TAG_AS_YOUR_ENGINE

# Your KPI engine's base URL (the proxy appends the relay hub path). Must be reachable from this
# container — e.g. https://kpi.yourco.example:8443, or https://host.docker.internal:8443 on the same host.
KPI_ENGINE_URL=https://kpi.yourco.example:8443

# This proxy's id (must match an entry in the engine's proxies.yaml) and its key (the engine stores only
# the SHA-256 hash under Reporting:Secrets:PROXY_<ID>). See docs/09 for generating the key/hash pair.
PROXY_ID=scouts-onprem1
PROXY_KEY=REPLACE_WITH_THE_GENERATED_KEY

# The Docker network of the DB's app stack (docker network ls), so the proxy can resolve the DB container.
APPSTACK_NETWORK=scouts_default
