# REFERENCE (.example = not loaded). A `custom` datasource whose builder fetches its OWN rows — here
# from a REST API. No DB connection is opened for you; your LoadFacts does the HTTP call using these
# params. Use a `secret:` only if the API needs a key (a public API needs none — drop the line).
id: weather
builder: WeatherCube
type: custom
secret: WEATHER_API          # optional — an API key/token; omit for a public API
freshness:
  mode: cached               # be gentle with third-party APIs — cache + refresh on a schedule
  refresh: "0 5 * * *"
loadWindow:
  from: "-2Y"
  to: "now"
params:
  baseUrl: "https://api.example.com/v1/metrics"
  parameters: "temp,rain"
